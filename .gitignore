# ============================================================
#  goatListenPrac
#
#  说明：用户数据默认放在仓库**外面**的 runtime/ 目录
#        （见 src/core.py 的 _resolve_runtime）。
#        下面这些规则是防止有人把数据放到仓库里时误提交。
# ============================================================

# ---- 用户数据 ----
mp3s/
transcript/
marks/
cards/
trans_cache/
runtime/
ui_state.json
ui_state.json.tmp
error.log

# ---- Anki 数据与程序 ----
data/
anki/

# ---- 第三方二进制（setup.py 自动下载）----
ffmpeg/

# ---- 构建产物（build/ 里是脚本，要提交；产物在这里）----
dist/
release/
*.spec
*.egg-info/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- 临时 ----
*.tmp
*.bak
~$*
